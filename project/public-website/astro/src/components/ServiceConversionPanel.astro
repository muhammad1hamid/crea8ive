---
import { serviceEnhancements } from "../data/growth";

interface Props {
  slug: string;
}

const data = serviceEnhancements[Astro.props.slug];
---
{data && (
  <section class="bg-[#080808] px-6 py-20 text-white">
    <div class="mx-auto max-w-[1400px]">
      <div class="grid gap-10 lg:grid-cols-[1fr_.8fr]">
        <div>
          <p class="font-orbitron text-xs uppercase tracking-[.3em] text-brand">{data.eyebrow}</p>
          <h2 class="mt-5 font-orbitron text-3xl font-bold leading-tight sm:text-5xl">{data.headline}</h2>
          <p class="mt-5 text-lg leading-8 text-white/70">{data.outcome}</p>
          <a href={`/contact/?service=${Astro.props.slug}`} class="mt-8 inline-flex border border-brand bg-brand px-6 py-3 font-orbitron text-xs uppercase tracking-wide text-white">
            {data.cta}
          </a>
        </div>
        <div class="grid gap-3 sm:grid-cols-3 lg:grid-cols-1">
          {data.metrics.map((metric) => (
            <div class="border border-white/10 bg-black p-5">
              <p class="font-orbitron text-2xl font-bold text-brand">{metric.value}</p>
              <p class="mt-2 text-sm leading-6 text-white/65">{metric.label}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-[1fr_.9fr]">
        <div class="border border-white/10 bg-black p-6">
          <h3 class="font-orbitron text-xl font-semibold">What is included</h3>
          <ul class="mt-6 grid gap-3">
            {data.deliverables.map((item) => (
              <li class="border-t border-white/10 pt-3 text-sm leading-6 text-white/70">{item}</li>
            ))}
          </ul>
        </div>
        <div class="border border-white/10 bg-black p-6">
          <h3 class="font-orbitron text-xl font-semibold">How it works</h3>
          <div class="mt-6 grid gap-3 sm:grid-cols-5 lg:grid-cols-1 xl:grid-cols-5">
            {data.process.map((step, index) => (
              <div class="border border-white/10 p-4">
                <p class="font-orbitron text-xs text-brand">0{index + 1}</p>
                <p class="mt-2 text-sm text-white/75">{step}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="mt-6 grid gap-6 lg:grid-cols-[.85fr_1fr]">
        <div class="border border-white/10 bg-black p-6">
          <p class="font-orbitron text-xs uppercase tracking-[.25em] text-brand">Premium Visual Direction</p>
          <h3 class="mt-4 font-orbitron text-2xl font-semibold">{data.visualConcept.title}</h3>
          <p class="mt-4 text-sm leading-7 text-white/65">{data.visualConcept.scene}</p>
          <p class="mt-5 border-t border-white/10 pt-4 text-xs leading-6 text-white/45">{data.visualConcept.proofNote}</p>
        </div>
        <div class="relative overflow-hidden border border-white/10 bg-[#050505] p-6">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_78%_18%,rgba(254,106,9,.24),transparent_30%),radial-gradient(circle_at_16%_84%,rgba(255,255,255,.08),transparent_24%)]"></div>
          <div class="relative grid gap-4 md:grid-cols-[1fr_.75fr]">
            <div class="border border-white/10 bg-black/70 p-5 backdrop-blur">
              <div class="mb-5 flex items-center justify-between gap-4">
                <span class="font-orbitron text-xs uppercase tracking-[.22em] text-white/55">System preview</span>
                <span class="h-2 w-2 rounded-full bg-brand shadow-[0_0_18px_rgba(254,106,9,.8)]"></span>
              </div>
              <div class="space-y-3">
                {data.process.slice(0, 4).map((step, index) => (
                  <div class="grid grid-cols-[2rem_1fr] items-center gap-3">
                    <span class="grid h-8 w-8 place-items-center border border-brand/50 bg-brand/10 font-orbitron text-[10px] text-brand">0{index + 1}</span>
                    <div>
                      <p class="font-orbitron text-xs uppercase tracking-wide text-white">{step}</p>
                      <div class="mt-2 h-1.5 bg-white/10">
                        <div class="h-full bg-brand" style={`width:${72 - index * 10}%`}></div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
            <div class="grid gap-3">
              {data.metrics.map((metric) => (
                <div class="border border-white/10 bg-white/[.04] p-4">
                  <p class="font-orbitron text-xl font-bold text-brand">{metric.value}</p>
                  <p class="mt-2 text-xs leading-5 text-white/60">{metric.label}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
)}
