---
import ToolCard from "./ToolCard.astro";
import { featuredTools, toolsBySlug } from "../data/tools";

interface Props {
  title?: string;
  intro?: string;
  slugs?: string[];
  showAllLink?: boolean;
}

const {
  title = "Not Sure What's Holding Your Growth Back?",
  intro = "Run a free audit before spending more.",
  slugs = featuredTools,
  showAllLink = true,
} = Astro.props;
const selectedTools = slugs.map((slug) => toolsBySlug[slug]).filter(Boolean);
---
<section class="bg-[#080808] px-6 py-20 text-white" aria-labelledby="tools-discovery-title">
  <div class="mx-auto max-w-[1400px]">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <p class="font-orbitron text-xs uppercase tracking-[.3em] text-brand">Free Growth Tools</p>
        <h2 id="tools-discovery-title" class="mt-5 font-orbitron text-3xl font-bold leading-tight sm:text-5xl">{title}</h2>
        <p class="mt-5 text-lg leading-8 text-white/70">{intro}</p>
      </div>
      {showAllLink && <a href="/tools/" class="inline-flex border border-brand bg-brand px-5 py-3 font-orbitron text-xs uppercase tracking-wide text-white">Explore All Free Tools →</a>}
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
      {selectedTools.map((tool) => <ToolCard tool={tool} compact />)}
    </div>
  </div>
</section>
