---
import ToolCard from "./ToolCard.astro";
import { serviceToolMap, toolsBySlug } from "../data/tools";

interface Props {
  slug: string;
}

const selectedTools = (serviceToolMap[Astro.props.slug] ?? []).map((slug) => toolsBySlug[slug]).filter(Boolean);
---
{selectedTools.length > 0 && (
  <section class="bg-black px-6 py-16 text-white" aria-labelledby="service-tools-title">
    <div class="mx-auto max-w-[1400px]">
      <div class="max-w-3xl">
        <p class="font-orbitron text-xs uppercase tracking-[.3em] text-brand">Check Before You Spend</p>
        <h2 id="service-tools-title" class="mt-5 font-orbitron text-3xl font-bold leading-tight sm:text-4xl">Use the relevant free tool for this service.</h2>
        <p class="mt-4 text-base leading-7 text-white/65">Get a practical score or estimate first, then bring better questions into the strategy call.</p>
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {selectedTools.map((tool) => <ToolCard tool={tool} compact />)}
      </div>
    </div>
  </section>
)}
