---
import { WHATSAPP_MESSAGE, WHATSAPP_NUMBER } from "../data/growth";
const waHref = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(WHATSAPP_MESSAGE)}`;
---
<section class="bg-black px-6 py-20 text-white">
  <div class="mx-auto grid max-w-[1400px] gap-8 lg:grid-cols-[.9fr_1.1fr]">
    <div>
      <p class="font-orbitron text-xs uppercase tracking-[.3em] text-brand">Start Here</p>
      <h2 class="mt-5 font-orbitron text-3xl font-bold leading-tight sm:text-5xl">
        Tell us what you want to grow. We will map the right system.
      </h2>
      <p class="mt-5 text-lg leading-8 text-white/70">
        Use the form for a detailed inquiry, or send a WhatsApp message if you want the fastest first conversation.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={waHref} target="_blank" rel="noopener noreferrer" class="border border-[#25D366] bg-[#25D366] px-5 py-3 font-orbitron text-xs uppercase tracking-wide text-white">
          WhatsApp Crea8iv
        </a>
        <a href="tel:+923135147935" class="border border-white/20 px-5 py-3 font-orbitron text-xs uppercase tracking-wide text-white">
          Call +92 313 5147935
        </a>
      </div>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {[
        ["Service routing", "Choose Meta Ads, Google Ads, GBP, website, content, branding, automation, course, or consultation."],
        ["Fast next step", "We reply with the clearest first action: audit, strategy call, proposal, or diagnostic question."],
        ["Local context", "Rawalpindi, Islamabad, Bahria Town, DHA, and Pakistan-wide growth systems."],
        ["Better briefs", "Include your city, business type, goal, and monthly budget range for sharper guidance."],
      ].map(([title, body]) => (
        <div class="border border-white/10 bg-white/[.03] p-6">
          <h3 class="font-orbitron text-lg font-semibold">{title}</h3>
          <p class="mt-3 text-sm leading-6 text-white/65">{body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
