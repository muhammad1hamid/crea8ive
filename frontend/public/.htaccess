  RewriteRule ^qa/tools/lead-response-calculator/?$ /tools/ [R=301,L,NE]
  RewriteRule ^qa/tools/local-seo-audit/?$ /tools/ [R=301,L,NE]
  RewriteRule ^qa/tools/seo-audit/?$ /tools/ [R=301,L,NE]
